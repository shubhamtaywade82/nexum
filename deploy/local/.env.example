# Copy to .env and fill in before `docker compose --env-file .env up`.

# Required — used for both the postgres container and DATABASE_URL.
POSTGRES_PASSWORD=change_me

# The coding workspace the Nexum agent operates on (mounted read-write into
# the nexum container at /workspace). Must be an absolute path.
NEXUM_WORKSPACE_ROOT=/absolute/path/to/your/project

# Ollama Cloud (https://ollama.com) — leave OLLAMA_HOST unset to use cloud;
# set it to http://host.docker.internal:11434 to reach a local Ollama
# running on your host machine instead.
OLLAMA_API_KEY=
OLLAMA_HOST=
