# ─────────────────────────────────────────────────────────────────────────────
# Nexum environment variables — copy to .env and uncomment what you need.
#
#   [required]   you must set it for that feature to work
#   [optional]   omit it and the default below applies
#
# Precedence:  NEXUM_*  >  DEVAGENT_* (deprecated, warns)  >  config file  >  default
# Every NEXUM_* key here has a config-file equivalent in camelCase
# (NEXUM_MODEL → "model"); the environment always wins over the file.
# Full reference: README.md §Environment Variables · docs/guide/configuration.md
# Companion file: config.example.jsonc (every config.json key, annotated)
# ─────────────────────────────────────────────────────────────────────────────

# ── Credentials & host ──────────────────────────────────────────────────────
# [required for cloud tier] primary key — first in the rotation pool
# OLLAMA_API_KEY=
# [optional] comma-separated extra keys for separate Ollama accounts.
# On a 429 the provider rotates to the next key instead of giving up.
# Prefer "accounts" in config.json when you want each key named in /usage.
# OLLAMA_API_KEYS=
# [optional] local Ollama URL (default: http://localhost:11434).
# Provider-convention variable — keep the upstream name. Ignored on cloud tier.
# OLLAMA_HOST=http://localhost:11434

# ── Model & routing ─────────────────────────────────────────────────────────
# [optional] default model tag (default: qwen3.5:4b)
# NEXUM_MODEL=qwen3.5:4b
# [optional] execution tier: local (default) | cloud
# NEXUM_TIER=local
# [optional] small local model tried first every turn; it escalates to the
# primary model via the escalate_task tool (no default — unset = no quick tier)
# NEXUM_QUICK_MODEL=minicpm5
# [optional] pin models per capability, comma-separated, e.g.
# NEXUM_MODEL_PREFS_REASONING=qwen3:32b,gemma4:cloud
# NEXUM_MODEL_PREFS_REASONING=
# [optional] request timeout in ms — cloud tier only, local never times out
# NEXUM_TIMEOUT_MS=60000
# [optional] session token budget, 0 = unlimited (default: 0)
# NEXUM_TOKEN_BUDGET=0

# ── Workspace ───────────────────────────────────────────────────────────────
# [optional] workspace root override — otherwise auto-detected as the nearest
# .git (then nearest .nexum/, then cwd)
# NEXUM_WORKSPACE=
# [optional] confine file-mutating tools to a subdirectory (relative to the
# workspace root, or absolute). Unset = the whole workspace.
# NEXUM_WRITE_SCOPE=

# ── System prompt ───────────────────────────────────────────────────────────
# [optional] replaces the built-in prompt (default: built-in Clean Code prompt)
# NEXUM_SYSTEM_PROMPT=

# ── Shell sandbox ───────────────────────────────────────────────────────────
# [optional] sandbox image (default: nexum-sandbox:latest)
# NEXUM_SHELL_IMAGE=nexum-sandbox:latest
# [optional] run shell commands on the host instead of Docker (default: true)
# host mode still asks for confirmation on every call
# NEXUM_SANDBOX=true
# [optional] shell command timeout in seconds (default: 30)
# NEXUM_SHELL_TIMEOUT_SEC=30
# [optional] mount the host docker tool — daemon access is root-equivalent
# (default: false)
# NEXUM_DOCKER_TOOL=false
# [optional] let docker-tool containers reach the network (default: false)
# NEXUM_DOCKER_EGRESS=false

# ── Tool selection ──────────────────────────────────────────────────────────
# [optional] heuristic | llm | hybrid — how tools are pruned each turn
# (default: hybrid)
# NEXUM_TOOL_SELECTION_MODE=hybrid
# [optional] cap on tools exposed per turn (default: 8)
# NEXUM_MAX_ACTIVE_TOOLS=8

# ── Approval & planning ─────────────────────────────────────────────────────
# [optional] approve destructive calls without prompting (default: false) —
# delete_file has no undo in this mode; use it in CI only
# NEXUM_AUTO_APPROVE=false
# [optional] offer multi-step requests to the plan orchestrator:
# ask (default) | always | off  (legacy NEXUM_PLAN_HINT=0 also means off)
# NEXUM_AUTO_PLAN=ask

# ── Hybrid local/cloud & quality gates ──────────────────────────────────────
# [optional] run trivial tasks on the quick local model first (default: true)
# NEXUM_LOCAL_WORKER=true
# [optional] critic pass that escalates a confident-wrong quick answer
# (default: false, experimental)
# NEXUM_VERIFIER=false
# [optional] temperature-style self-consistency voting (default: false)
# NEXUM_SELF_CONSISTENCY=false
# NEXUM_SC_N=3                          # [optional] votes to collect (default: 3)
# NEXUM_SC_THRESHOLD=0.5                # [optional] agreement needed (default: 0.5)
# [optional] cache cloud availability probes (default: true)
# NEXUM_AVAIL_CHECK=true
# NEXUM_AVAIL_TTL_MS=86400000           # [optional] probe TTL, 24h (default: 86400000)
# [optional] block the LLM heuristic's own allow decisions (default: true)
# NEXUM_HEURISTIC_GATE=true

# ── Cost estimate ───────────────────────────────────────────────────────────
# [optional] Ollama publishes no per-token price, so cost tracking stays off
# until you supply your own rate, in USD per million tokens
# NEXUM_PRICE_INPUT_PER_M=
# NEXUM_PRICE_OUTPUT_PER_M=

# ── Appearance ──────────────────────────────────────────────────────────────
# [optional] TUI theme (default): default | midnight | solarized | dracula |
# nord | github | gruvbox | tokyo-night | monokai | catppuccin | one-dark |
# vercel | high-contrast | high-contrast-light
# NEXUM_THEME=default

# ── Decision Plane (System One) ─────────────────────────────────────────────
# [optional] bounded decision subsystem (default: false; auto-off on cloud tier)
# NEXUM_DECISION=false
# NEXUM_DECISION_MODEL=tev1             # [optional] dedicated model (default: tev1)
# [optional] plugin/settings profile (default: nexum-cli)
# NEXUM_PROFILE=nexum-cli

# ── Semantic memory ─────────────────────────────────────────────────────────
# [optional] embedding-backed long-term memory, auto-mounted for every agent
# (default: on; 0 disables the memory + rag packs)
# NEXUM_SEMANTIC_MEMORY=1

# ── Host service (nexum serve) ──────────────────────────────────────────────
# [optional] loopback bind address (default: 127.0.0.1)
# NEXUM_HOST_BIND=127.0.0.1
# [optional] port (default: 3777)
# NEXUM_HOST_PORT=3777
# [optional] base URL other processes use to reach the host
# NEXUM_HOST_URL=http://127.0.0.1:3777
# [optional] URL a client connects to (default: NEXUM_HOST_URL or that URL)
# NEXUM_SERVER_URL=http://127.0.0.1:3777
# [required when binding to a non-loopback address] shared auth token
# NEXUM_SERVER_TOKEN=

# ── Telemetry ───────────────────────────────────────────────────────────────
# [optional] process-wide spans + metrics (default: on; 0 disables)
# NEXUM_TELEMETRY_ENABLED=1
# [optional] OTLP/HTTP traces endpoint for span export (default: unset)
# NEXUM_OTEL_EXPORTER_OTLP_ENDPOINT=
# NEXUM_OTEL_SERVICE_NAME=nexum         # [optional] resource service.name
# NEXUM_OTEL_EXPORT_INTERVAL_MS=60000   # [optional] batch export interval

# ── Advanced: bounded buffers ───────────────────────────────────────────────
# [optional] hard caps that keep long sessions bounded in memory
# NEXUM_MAX_LOGS=500
# NEXUM_MAX_CONVERSATION=500
# NEXUM_MAX_TOOL_CALLS=200
# NEXUM_MAX_NOTIFICATIONS=20
# [optional] grace period before a running host request is dropped on shutdown
# NEXUM_SHUTDOWN_GRACE_MS=5000

# ── Development ─────────────────────────────────────────────────────────────
# [optional] silence DEVAGENT_* deprecation warnings (CI)
# NEXUM_NO_DEPRECATION_WARNINGS=1
# [optional] log raw stdin to .nexum/paste-debug.log while debugging the TUI
# NEXUM_DEBUG_STDIN=0

# ── DevAgent → Nexum migration ──────────────────────────────────────────────
# Legacy DEVAGENT_* variables are still honored (with a deprecation warning)
# until the next major version. NEXUM_* always wins when both are set.
# Run `nexum migrate` to move a legacy .devagent workspace to .nexum.
