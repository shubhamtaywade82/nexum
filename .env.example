# Ollama server URL (local tier) — provider-convention variable, keeps its name
# OLLAMA_HOST=http://localhost:11434

# API key for cloud tier (https://ollama.com) — provider-convention variable
# OLLAMA_API_KEY=

# Default model tag
# NEXUM_MODEL=qwen3.5:4b

# Tier: "local" (default) or "cloud"
# NEXUM_TIER=local

# Preferred local model name (substring match) for the "quick" capability —
# wins over any other locally-installed small model, cloud only as fallback
# if this specific model is unavailable. e.g. minicpm5-1b:
# NEXUM_QUICK_MODEL=minicpm5

# Workspace root directory (defaults to process.cwd())
# NEXUM_WORKSPACE=

# Request timeout in milliseconds
# NEXUM_TIMEOUT_MS=60000

# Custom system prompt (overrides built-in default)
# NEXUM_SYSTEM_PROMPT=

# Docker image for sandboxed shell execution
# NEXUM_SHELL_IMAGE=nexum-sandbox:latest

# Shell command timeout in seconds
# NEXUM_SHELL_TIMEOUT_SEC=30

# Cloud token budget guard (0 = off)
# NEXUM_TOKEN_BUDGET=0

# ── DevAgent → Nexum migration ─────────────────────────────────────────────
# Legacy DEVAGENT_* variables are still honored (with a deprecation warning)
# until the next major version. NEXUM_* always wins when both are set.
# Run `nexum migrate` to move a legacy .devagent workspace to .nexum.

# NEXUM_SANDBOX=false