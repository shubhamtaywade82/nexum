{
  "name": "@nemesis-oss/nexum",
  "version": "2.0.0-alpha.2",
  "description": "Nexum — open-source agent runtime and harness for autonomous software engineering: capability-routed local & cloud models, Docker sandbox, LSP code intelligence, and a terminal UI.",
  "keywords": ["nexum", "agent-runtime", "agent", "ai", "llm", "coding-assistant", "tui", "cli", "typescript", "docker", "sandbox", "lsp", "mcp", "ollama"],
  "license": "MIT",
  "author": "Shubham Taywade <shubhamtaywade82@gmail.com>",
  "homepage": "https://github.com/nemesis-oss/nexum#readme",
  "repository": {"type": "git", "url": "git+https://github.com/nemesis-oss/nexum.git"},
  "bugs": {"url": "https://github.com/nemesis-oss/nexum/issues"},
  "publishConfig": {"access": "public", "registry": "https://registry.npmjs.org/"},
  "type": "module",
  "stability": "experimental",
  "engines": {"node": ">=22"},
  "bin": {"nexum": "bin/cli.js", "devagent": "bin/cli.js", "devagent-ts": "bin/cli.js"},
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "NEXUM_TEST_NO_GLOBAL=true node --experimental-vm-modules node_modules/.bin/jest",
    "start": "node dist/ui/index.js",
    "dev": "tsx src/ui/index.ts",
    "dev:legacy": "tsx src/cli/tui.ts",
    "benchmark": "tsx src/benchmark/cli.ts",
    "docs:ingest": "tsx src/docs/cli.ts",
    "doctor": "tsx src/cli/doctor.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint src tests",
    "format:check": "prettier --check src tests",
    "package:check": "node scripts/check-package.mjs",
    "release:check": "npm run lint && npm run format:check && npm run build && npm test && npm run package:check",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1", "@types/better-sqlite3": "^7.6.13", "@types/diff": "^7.0.2", "@types/jest": "^30.0.0", "@types/marked-terminal": "^6.1.1", "@types/node": "^26.1.1", "@types/react": "^19.2.17", "@types/ws": "^8.18.1", "@typescript-eslint/eslint-plugin": "^8.65.0", "@typescript-eslint/parser": "^8.65.0", "eslint": "^10.7.0", "globals": "^17.7.0", "ink-testing-library": "^4.0.0", "jest": "^30.4.2", "prettier": "^3.9.5", "ts-jest": "^29.2.0", "tsx": "^4.23.1", "typescript": "^6.0.3", "vitepress": "^1.6.4"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0", "@nemesis-oss/ollama-sdk": "^1.3.0", "better-sqlite3": "^12.11.1", "boxen": "^8.0.1", "chalk": "^5.6.2", "cheerio": "^1.2.0", "cli-highlight": "^2.1.11", "cli-spinners": "^3.4.0", "diff": "^9.0.0", "dotenv": "^17.4.2", "gray-matter": "^4.0.3", "ink": "^7.1.1", "marked": "^15.0.12", "marked-terminal": "^7.3.0", "ora": "^9.4.1", "playwright": "^1.61.1", "react": "^19.2.7", "string-width": "^8.2.2", "vscode-languageserver-protocol": "^3.18.2", "vscode-languageserver-types": "^3.18.0", "vscode-uri": "^3.1.0", "ws": "^8.21.1", "zod": "^4.4.3"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {"types": "./dist/index.d.ts", "import": "./dist/index.js"},
    "./core": {"types": "./dist/core/index.d.ts", "import": "./dist/core/index.js"},
    "./runtime": {"types": "./dist/runtime/index.d.ts", "import": "./dist/runtime/index.js"},
    "./models": {"types": "./dist/models/index.d.ts", "import": "./dist/models/index.js"},
    "./tools": {"types": "./dist/tools/index.d.ts", "import": "./dist/tools/index.js"},
    "./mcp": {"types": "./dist/mcp/index.d.ts", "import": "./dist/mcp/index.js"},
    "./orchestration": {"types": "./dist/orchestration/index.d.ts", "import": "./dist/orchestration/index.js"},
    "./evolution": {"types": "./dist/evolution/index.d.ts", "import": "./dist/evolution/index.js"},
    "./provider": {"types": "./dist/models/adapters/provider.d.ts", "import": "./dist/models/adapters/provider.js"},
    "./catalog": {"types": "./dist/models/catalog.d.ts", "import": "./dist/models/catalog.js"},
    "./router": {"types": "./dist/models/router/router.d.ts", "import": "./dist/models/router/router.js"},
    "./agent": {"types": "./dist/cli/agent.d.ts", "import": "./dist/cli/agent.js"}
  },
  "files": ["dist/", "bin/", "README.md", "LICENSE"],
  "allowScripts": {"better-sqlite3@12.11.1": true, "esbuild@0.21.5": true, "esbuild@0.28.1": true, "unrs-resolver@1.12.2": true}
}
